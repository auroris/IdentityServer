<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>IdentityServer</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>AurorisNet.IdentityServer</PackageId>
    <Authors>AurorisNet</Authors>
    <Description>Embeddable OpenID Connect server for ASP.NET Core, backed by Active Directory, Samba AD or FreeIPA.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/auroris/IdentityServer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/IdentityServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="7.7.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.14" />
    <ProjectReference Include="..\ActiveDirectory\ActiveDirectory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IdentityServer.Tests" />
    <!-- Ship this project's NuGet-specific README, separate from the repository overview. -->
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
