{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "ServerUri": "*",
    "AccessTokenLifetime": "01:00:00",
    "IdentityTokenLifetime": "01:00:00",
    "AuthorizationCodeLifetime": "00:05:00",
    "UseForwardedHeaders": false,
    "PersistKeys": false,
    "Hosts": [
      "http://localhost",
      "https://localhost",
      "https://oidcdebugger.com"
    ],
    "Clients": [
      {
        "ClientId": "optional"
      }
    ],
    "Groups": []
  }
}
