[Unit]
Description=IdentityServer OpenID Connect service (native Kerberos HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=identityserver
Group=identityserver
WorkingDirectory=/opt/identityserver
ExecStart=/usr/bin/dotnet /opt/identityserver/IdentityServer.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=KRB5_KTNAME=FILE:/etc/identityserver/http.keytab
EnvironmentFile=/etc/identityserver/identityserver.env
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90
StateDirectory=identityserver
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/identityserver/logs

[Install]
WantedBy=multi-user.target
