{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    }
  },
  "AllowedHosts": "identity.example.com",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443",
        "Certificate": {
          "Path": "/etc/identityserver/tls/fullchain.pem",
          "KeyPath": "/etc/identityserver/tls/privkey.pem"
        }
      }
    }
  },
  "IdentityServer": {
    "ServerUri": "https://identity.example.com:8443",
    "Authentication": { "Mode": "Kerberos" },
    "Directory": {
      "Provider": "SambaAd",
      "Server": "ldaps://dc.example.com",
      "Realm": "EXAMPLE.COM",
      "BaseDn": "DC=example,DC=com",
      "BindDn": "identityserver-reader@EXAMPLE.COM"
    },
    "PersistKeys": true,
    "DataPath": "/var/lib/identityserver/keys",
    "AccessTokenLifetime": "01:00:00",
    "IdentityTokenLifetime": "01:00:00",
    "AuthorizationCodeLifetime": "00:05:00",
    "Hosts": ["https://app.example.com"],
    "Clients": [{ "ClientId": "example-app" }],
    "Groups": []
  }
}
