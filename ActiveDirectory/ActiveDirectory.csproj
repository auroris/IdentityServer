<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one copy of the Active Directory wrapper library. The identity server references it from
    here; other applications can add a ProjectReference to this
    file instead of keeping their own copy.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ActiveDirectory</AssemblyName>
    <RootNamespace>ActiveDirectory</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>AurorisNet.ActiveDirectory</PackageId>
    <Authors>AurorisNet</Authors>
    <Description>Windows Active Directory wrappers used by AurorisNet.IdentityServer, with helpers for users, groups and directory searches.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/auroris/IdentityServer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/IdentityServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- System.DirectoryServices only works on Windows. Like the identity server, the library
         silences the platform-compatibility analyzer instead of annotating every member, so
         consumers do not inherit Windows-only warnings at each call site. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices" Version="10.0.14" />
    <!-- Ship this project's NuGet-specific README, separate from the repository overview. -->
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
